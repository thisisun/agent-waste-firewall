{
  "name": "agent-waste-firewall",
  "version": "0.1.0",
  "description": "AWF is a local-first live monitor, prompt coach, and no-progress circuit breaker for Codex and Claude Code.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thisisun/agent-waste-firewall.git"
  },
  "bugs": {
    "url": "https://github.com/thisisun/agent-waste-firewall/issues"
  },
  "homepage": "https://github.com/thisisun/agent-waste-firewall#readme",
  "bin": {
    "agent-waste-firewall": "./bin/agent-waste-firewall.mjs"
  },
  "files": [
    ".agents/",
    ".claude-plugin/",
    ".codex-plugin/",
    "assets/",
    "bin/",
    "hooks/",
    "fixtures/",
    "protocol/",
    "runtime/node-runtime-v1.json",
    "runtime/node-runtime.entitlements",
    "scripts/",
    "src/",
    "docs/",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "design-qa.md",
    "LICENSE",
    "README.md",
    "README.ko.md",
    "SECURITY.md"
  ],
  "scripts": {
    "acceptance:claude": "node scripts/claude-provider-acceptance.mjs",
    "acceptance:codex": "node scripts/provider-acceptance.mjs",
    "acceptance:providers": "npm run acceptance:codex && npm run acceptance:claude",
    "benchmark:dashboard": "node scripts/benchmark-dashboard.mjs",
    "benchmark:hook": "node scripts/benchmark-hook.mjs",
    "benchmark:native-hook": "node scripts/benchmark-native-hook.mjs",
    "benchmark:live-dashboard": "node scripts/benchmark-live-dashboard.mjs",
    "benchmark:live-spool": "node scripts/benchmark-live-spool.mjs",
    "prepare:macos-runtime": "node scripts/prepare-macos-runtime.mjs",
    "finalize:macos-runtime": "node scripts/finalize-macos-runtime.mjs",
    "check": "node scripts/check.mjs",
    "prepublishOnly": "npm run check && npm test",
    "test": "node --test",
    "test:coverage": "node --test --experimental-test-coverage"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "ai-agents",
    "claude-code",
    "codex",
    "guardrails",
    "hooks",
    "token-usage"
  ],
  "license": "Apache-2.0"
}
