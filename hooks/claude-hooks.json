{
  "description": "Checks prompts and detects no-progress coding-agent loops locally in Claude Code.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh",
            "args": [
              "-p",
              "${CLAUDE_PLUGIN_ROOT}/scripts/hook-launcher.sh",
              "${CLAUDE_PLUGIN_ROOT}"
            ],
            "timeout": 3
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh",
            "args": [
              "-p",
              "${CLAUDE_PLUGIN_ROOT}/scripts/hook-launcher.sh",
              "${CLAUDE_PLUGIN_ROOT}"
            ],
            "timeout": 3
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh",
            "args": [
              "-p",
              "${CLAUDE_PLUGIN_ROOT}/scripts/hook-launcher.sh",
              "${CLAUDE_PLUGIN_ROOT}"
            ],
            "timeout": 3
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh",
            "args": [
              "-p",
              "${CLAUDE_PLUGIN_ROOT}/scripts/hook-launcher.sh",
              "${CLAUDE_PLUGIN_ROOT}"
            ],
            "timeout": 3
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh",
            "args": [
              "-p",
              "${CLAUDE_PLUGIN_ROOT}/scripts/hook-launcher.sh",
              "${CLAUDE_PLUGIN_ROOT}"
            ],
            "timeout": 3
          }
        ]
      }
    ]
  }
}
