{
  "description": "Checks prompts and detects no-progress coding-agent loops locally in Codex.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh -p \"${PLUGIN_ROOT}/scripts/hook-launcher.sh\" \"${PLUGIN_ROOT}\" codex",
            "timeout": 3,
            "additionalContextLimit": 2500
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh -p \"${PLUGIN_ROOT}/scripts/hook-launcher.sh\" \"${PLUGIN_ROOT}\" codex",
            "timeout": 3,
            "additionalContextLimit": 2500
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh -p \"${PLUGIN_ROOT}/scripts/hook-launcher.sh\" \"${PLUGIN_ROOT}\" codex",
            "timeout": 3,
            "additionalContextLimit": 2500
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh -p \"${PLUGIN_ROOT}/scripts/hook-launcher.sh\" \"${PLUGIN_ROOT}\" codex",
            "timeout": 3
          }
        ]
      }
    ]
  }
}
